# ==============================================================================
# Bariton Music Academy - Hostpinnacle Production Environment Configuration
# Target Domains:
#   - Frontend Vue SPA:   https://app.bmas.com
#   - Backend Laravel API: https://api.bmas.com
# ==============================================================================

APP_NAME="Bariton Music Academy"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://api.bmas.com
APP_TIMEZONE=Africa/Nairobi

# Frontend SPA origin for CORS, Cookies, and Links
FRONTEND_URL=https://app.bmas.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database Configuration (Hostpinnacle cPanel MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bmas_production
DB_USERNAME=bmas_dbuser
DB_PASSWORD="SECURE_DATABASE_PASSWORD"

# Session & Sanctum Domain Configuration
# Setting SESSION_DOMAIN=.bmas.com allows cookie sharing across subdomains
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.bmas.com
SANCTUM_STATEFUL_DOMAINS=app.bmas.com

# File Storage
FILESYSTEM_DISK=local
BARITON_PRIVATE_DISK=local

# Queue & Cache
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email Delivery (Hostpinnacle SMTP or Transactional Mailer)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.bmas.com
MAIL_PORT=465
MAIL_USERNAME=notifications@bmas.com
MAIL_PASSWORD="SECURE_SMTP_PASSWORD"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@bmas.com"
MAIL_FROM_NAME="Bariton Music Academy"

# Africa's Talking SMS Production
AT_USERNAME=baritonmusic
AT_API_KEY=YOUR_PRODUCTION_AT_API_KEY
AT_SENDER_ID=BARITON
AT_WEBHOOK_TOKEN=YOUR_PRODUCTION_DELIVERY_TOKEN

# Payment Gateways (Live)
CARD_DRIVER=stripe
STRIPE_KEY=pk_live_...
STRIPE_SECRET=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

PAYPAL_MODE=live
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_WEBHOOK_ID=...

MPESA_ENV=live
MPESA_CONSUMER_KEY=...
MPESA_CONSUMER_SECRET=...
MPESA_SHORTCODE=...
MPESA_PASSKEY=...
MPESA_CALLBACK_TOKEN=SECURE_MPESA_CALLBACK_TOKEN

# ==============================================================================
# Hostpinnacle cPanel Cron Job Configuration:
# Add this line in cPanel -> Cron Jobs (every minute):
# * * * * * cd /home/bmas/api.bmas.com && /usr/local/bin/php artisan schedule:run >> /dev/null 2>&1
# ==============================================================================
